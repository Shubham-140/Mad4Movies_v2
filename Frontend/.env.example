# TMDB requires a browser-visible key for direct API calls from the client.
VITE_TMDB_API_KEY=your_tmdb_api_key

# Backend API (use http://localhost:3000 for local backend)
VITE_API_URL=https://mad4movies.onrender.com

# Public site URL used in share links (never localhost)
VITE_FRONTEND_URL=https://mad4movies.vercel.app
